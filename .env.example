# ThatTechStore — environment variables
# Copy to `.env.local` for local development (Windows: `copy .env.example .env.local`).
# Secrets must never be committed. See docs/supabase-setup.md for Supabase steps.

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: force seasonal hero regardless of date (heat | storms | outages)
# NEXT_PUBLIC_FORCE_SEASON=

# ── Supabase (required for connectivity / Phase 2+) ─────────────────────────
# Project URL from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# anon / public key (JWT) — Dashboard → Project Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role — server-only later (webhooks/admin). Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# ── Later phases (payments) ──────────────────────────────────────────────────
# FLUTTERWAVE_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_WEBHOOK_SECRET=

# ── Later phases (WhatsApp CTA) ──────────────────────────────────────────────
# NEXT_PUBLIC_WHATSAPP_NUMBER=
